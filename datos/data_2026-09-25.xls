<!-- Respuesta Cl@ve, hace peticion POST a esta pagina, al iniciar el controlador se recogen los parametros 
	para almacenarlos en variables que puedan ser utilizadas en AuthenticationCtrl -->
<body id="principal" class="geoportal" data-ng-controller="MainController">

	<!-- Modal -->
	<div class="modalErrores fade in" id="modalErroresApp" tabindex="-1" role="dialog" data-ng-if="showModalErrors" aria-labelledby="modalErroresLabel" aria-hidden="true">
		<div class="modalErrores-dialog">
			<div class="modalErrores-content">
				<div class="modalErrores-header">
					<span class="modalErrores-title" id="modalErroresLabel" data-translate="Errores"></span>
					<button type="button" class="closeErrores" data-dismiss="modal"
							aria-hidden="true" data-ng-click="closeModalErrors()">&times;</button>
				</div>
				<div id="contentErrores" class="modalErrores-body">
					<ul>
						<li data-ng-repeat="errorItem in errors track by $index">
							<span data-translate="{{errorItem}}"></span>
						</li>			
					</ul>
				</div>
			</div>
		</div>
	</div>
	
	<div data-ng-switch on="hideHeaderFooter">
		
		<div data-ng-switch-default>
			<div data-ng-show="mostrarCookies">
				<ng-include
					src="'resources/app/modules/avisoCookies/avisoCookies.html'"></ng-include>
			</div>

			<div class="container">
				<div class="banner">
					<div class="header" class="header">
						<div class="oculto">
							<a href="#contenido" title="{{'header.title.saltarnavegacion' | translate}}"
								accesskey="s" tabindex="-1"
								data-translate="header.saltaropciones">{{header.title.saltarnavegacion | translate}}</a>
						</div>

						<h2 class="oculto" data-translate="header.seleccionidioma">{{header.seleccionidioma | translate}}</h2>

						<div class="idiomas">
							<div data-ng-translate-language-select></div>
						</div>
						<a
							href="https://www.miteco.gob.es/es/energia.html">
							<img class="imgseleccionable"
							src="https://sedeaplicaciones.minetur.gob.es/EstilosSedeElectronica/SiteCollectionImages/SedeElectronica/mte-gob.png"
							alt="{{'header.alt.iralministerio' | translate}}" />
						</a>

						<div class="tag-line"></div>
						<div class="titulo-aplicacion">
							<a
								href="https://sede.minetur.gob.es/es-ES/datosabiertos/catalogo/precios-carburantes"
								title="header.link.openData" target="_blank"> <img
								src="resources/imagenes/im-open-data.png"
								alt="{{'header.link.openData' | translate}}" />
								<h1>GEOPORTAL</h1>
							</a>
						</div>
						<h2 class="oculto" data-translate="header.menuayuda">{{header.menuayuda | translate}}</h2>
						<div id="ayuda" class="ayuda"
							data-ng-controller="AuthenticationCtrl">
							<ul>
								
								<li class="secondChild">
									<a href="https://www.miteco.gob.es/es/ministerio/servicios/informacion/informacion-y-atencion-al-ciudadano" 
										accesskey="0" target="_blank" data-translate="nav.contacto" 
										title="{{'nav.contacto'| translate}}">{{nav.contacto | translate}}</a></li>
										
								<li class="secondChild"><a
									href="https://energia.gob.es/risp/faq/Paginas/faqs.aspx"
									target="_blank" accesskey="p"
									data-translate="nav.pregFrecuentes" title="{{'nav.pregFrecuentes'| translate}}">{{nav.pregFrecuentes | translate}}</a></li>
							</ul>
							
							<!-- 	Box de Cargando reloadinnngg!!!! -->
							<div id="boxLoading" class="loading" data-ng-show="inloading"
								class="ruletaCarga loading verticalalignmiddle">
								<span data-translate="dialogoEspera.mensaje"></span>&nbsp;<img
									class="imagenLoadin"
									src="resources/imagenes/incoherenciaPrecios/DXR.gif"
									alt="{{'alt.cargando' | translate}}" />
							</div>
						</div>
					</div>
				</div>

				<div class="contenido">
				
				<div class="nav" style="visibility:hidden">
						<ng-include	src="'resources/app/modules/navegacion/navegacion.html'"></ng-include>
					</div>

					<div id="contenidoPrincipal">
						<div data-ng-view></div>
					</div>

					<div class="clear"></div>
				</div>

				<div class="footer">
					<div class="footer-contenedor">
						<div class="left-footer">
							<p>Gobierno de Espa&ntilde;a. Ministerio para la
								Transici&oacute;n Ecol&oacute;gica y el Reto Demogr&aacute;fico.</p>
							<p>
								Plaza de San Juan de la Cruz, s/n, <abbr title="C&oacute;digo Postal">C.P.</abbr><span class="postal-code">28071</span>
								<span class="locality">Madrid</span> <span class="region">Espa&ntilde;a</span>.
							</p>
						</div>
						<div class="right-footer">
							<a href="https://www.w3.org/WAI/WCAG1AA-Conformance"
								title="Explicaci&oacute;n del Nivel Doble-A de Conformidad"
								class="sinSubrayado" target="_black"> <img
								src="https://sedeaplicaciones.minetur.gob.es/EstilosSedeElectronica/SiteCollectionImages/SedeElectronica/icono3_waiAA.gif"
								alt="Icono de conformidad con el Nivel Doble A, de las Directrices de Accesibilidad para el Contenido Web 2.0 del W3C-WAI" />
							</a> <a href="https://jigsaw.w3.org/css-validator"
								class="sinSubrayado" target="_black" id="linkValidatorCSS">
								<img src="https://jigsaw.w3.org/css-validator/images/vcss"
								alt="CSS V&aacute;lido" width="70" height="25" />
							</a> <a href="https://validator.w3.org" class="sinSubrayado"
								target="_black" id="linkValidatorXHTML"> <img
								src="https://sedeaplicaciones.minetur.gob.es/EstilosSedeElectronica/SiteCollectionImages/SedeElectronica/icono1_xhtml1.gif"
								alt="XHTML 1.0 V&aacute;lido" />
							</a>
							<p class="oculto" title="{{accesibilidad.fechaultimarevision |translate}}"><span class="oculto" data-translate="accesibilidad.fechaultimarevision"></span> 10/07/2018</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</body>
</html>